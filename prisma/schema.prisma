generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  artisan
  admin
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  requested
  accepted
  in_progress
  completed
  cancelled
  disputed
}

enum EscrowStatus {
  held
  released
  refunded
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  phone         String   @unique
  email         String?
  role          UserRole @default(user)
  location      String?
  accountStatus AccountStatus @default(active) @map("account_status")
  createdAt     DateTime @default(now()) @map("created_at")

  artisanProfile      ArtisanProfile?
  bookings            Booking[]            @relation("UserBookings")
  reviews             Review[]             @relation("UserReviews")
  reviewedDocuments   VerificationDocument[] @relation("ReviewedBy")
  kycVerifications    KycVerification[]
  signupPayments      SignupPayment[]
  reviewedPayments    SignupPayment[]      @relation("PaymentReviewedBy")

  @@map("users")
}

enum AccountStatus {
  pending_payment
  active
  suspended
}

model ArtisanProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  trade                String             @default("plumber")
  bio                  String?
  serviceArea          String?            @map("service_area")
  verificationStatus   VerificationStatus @default(pending) @map("verification_status")
  subscriptionStatus   String             @default("none") @map("subscription_status")
  averageRating        Decimal            @default(0) @map("average_rating") @db.Decimal(3, 2)
  jobsCompleted        Int                @default(0) @map("jobs_completed")
  createdAt            DateTime           @default(now()) @map("created_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationDocuments  VerificationDocument[]
  services               Service[]
  bookings               Booking[]
  reviews                Review[]
  subscriptions          Subscription[]
  kycVerifications       KycVerification[]

  @@map("artisan_profiles")
}

model VerificationDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  artisanId          String             @map("artisan_id") @db.Uuid
  ghanaCardUrl       String?            @map("ghana_card_url")
  ghanaCardNumber    String?            @map("ghana_card_number")
  policeReportUrl    String?            @map("police_report_url")
  residenceProofUrl  String?            @map("residence_proof_url")
  guarantorName      String?            @map("guarantor_name")
  guarantorPhone     String?            @map("guarantor_phone")
  skillsEvidenceUrls String[]           @default([]) @map("skills_evidence_urls")
  status             VerificationStatus @default(pending)
  reviewedById       String?            @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@map("verification_documents")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  artisanId   String   @map("artisan_id") @db.Uuid
  title       String
  description String?
  priceAmount Decimal  @map("price_amount") @db.Decimal(12, 2)
  priceUnit   String   @default("job") @map("price_unit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  artisan  ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("services")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  artisanId          String        @map("artisan_id") @db.Uuid
  serviceId          String?       @map("service_id") @db.Uuid
  location           String?
  problemDescription String?       @map("problem_description")
  agreedPrice        Decimal?      @map("agreed_price") @db.Decimal(12, 2)
  status             BookingStatus @default(requested)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user    User           @relation("UserBookings", fields: [userId], references: [id])
  artisan ArtisanProfile @relation(fields: [artisanId], references: [id])
  service Service?       @relation(fields: [serviceId], references: [id])
  payment Payment?
  review  Review?

  @@map("bookings")
}

model Payment {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @unique @map("booking_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  commission        Decimal      @default(0) @db.Decimal(12, 2)
  escrowStatus      EscrowStatus @default(held) @map("escrow_status")
  paystackReference String?      @map("paystack_reference")
  createdAt         DateTime     @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  artisanId String   @map("artisan_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User           @relation("UserReviews", fields: [userId], references: [id])
  artisan ArtisanProfile @relation(fields: [artisanId], references: [id])

  @@map("reviews")
}

model Subscription {
  id            String   @id @default(uuid()) @db.Uuid
  artisanId     String   @map("artisan_id") @db.Uuid
  plan          String
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  paymentStatus String   @default("pending") @map("payment_status")
  createdAt     DateTime @default(now()) @map("created_at")

  artisan ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum OtpPurpose {
  login
  signup
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  phone       String
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose @default(login)
  expiresAt   DateTime   @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_codes")
}

model PlatformSetting {
  id               String   @id @default(uuid()) @db.Uuid
  commissionRate   Decimal  @default(12) @map("commission_rate") @db.Decimal(5, 2)
  subscriptionFee  Decimal  @default(50) @map("subscription_fee") @db.Decimal(12, 2)
  userSignupFee    Decimal  @default(20) @map("user_signup_fee") @db.Decimal(12, 2)
  artisanSignupFee Decimal  @default(50) @map("artisan_signup_fee") @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

enum PaymentMethodType {
  mtn_momo
  telecel_cash
  bank_transfer
  other
}

model PaymentMethod {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  type        PaymentMethodType @default(other)
  accountName String?           @map("account_name")
  accountNumber String?         @map("account_number")
  bankName    String?           @map("bank_name")
  instructions String?
  isActive    Boolean           @default(true) @map("is_active")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  signupPayments SignupPayment[]

  @@map("payment_methods")
}

enum SignupPaymentStatus {
  pending
  confirmed
  rejected
}

model SignupPayment {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  methodId        String              @map("method_id") @db.Uuid
  amount          Decimal             @db.Decimal(12, 2)
  role            UserRole
  reference       String
  proofUrl        String              @map("proof_url")
  status          SignupPaymentStatus @default(pending)
  rejectionReason String?             @map("rejection_reason")
  reviewedById    String?             @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     PaymentMethod @relation(fields: [methodId], references: [id])
  reviewedBy User?         @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("signup_payments")
}

model AdminNotification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime? @map("read_at")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([readAt, createdAt])
  @@map("admin_notifications")
}

enum KycStatus {
  draft
  pending
  verified
  rejected
  error
}

model KycVerification {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  artisanId          String?   @map("artisan_id") @db.Uuid
  status             KycStatus @default(draft)
  provider           String    @default("smile_identity")
  providerJobId      String?   @map("provider_job_id")
  providerUserId     String?   @map("provider_user_id")
  ghanaCardNumber    String?   @map("ghana_card_number")
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  documentFrontUrl   String?   @map("document_front_url")
  documentBackUrl    String?   @map("document_back_url")
  selfieUrl          String?   @map("selfie_url")
  livenessImageUrls  String[]  @default([]) @map("liveness_image_urls")
  extractedFields    Json?     @map("extracted_fields")
  failureReason      String?   @map("failure_reason")
  providerRawResult  Json?     @map("provider_raw_result")
  consentGrantedAt   DateTime? @map("consent_granted_at")
  submittedAt        DateTime? @map("submitted_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  artisan ArtisanProfile? @relation(fields: [artisanId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([providerJobId])
  @@map("kyc_verifications")
}
