# Postgres (required for auth + app data)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=housemate

# SMTP (OTP + approval emails). Port 1025 is typical for local Mailpit/MailHog.
# Production: use your provider's host. Port 465 -> MAIL_ENCRYPTION=ssl; port 587 -> MAIL_ENCRYPTION=tls.
# Many hosts block outgoing SMTP ports; failures are written to logs/app.log (scope "mail").
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@housemate.com
MAIL_FROM_NAME=Housemate

# Set to true only when debugging OTP delivery locally (returns code in API responses)
# OTP_DEV_MODE=true

# Where uploaded files are stored (defaults to ./storage/uploads).
# In production, point this at a persistent directory outside the deploy folder.
# UPLOAD_DIR=/var/craftviva/uploads

# App logs (JSON lines) are written to <LOG_DIR>/app.log; defaults to ./logs. Tail with: npm run logs
# LOG_DIR=/var/log/craftviva

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (booking escrow payments + provider payouts). Leave blank to use the built-in test/mock flow.
# Webhook URL to set in the Paystack dashboard: <NEXT_PUBLIC_SITE_URL>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Signs login cookies. Required in production (32+ random characters).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# The "demo admin" login shortcut is always off in production. Set to false to disable it locally too.
# ENABLE_DEMO_ADMIN=false

# Smile Identity KYC (optional — verification uses manual admin review by default)
# Leave blank; artisans submit Ghana Card + face check, admins approve at /admin/verifications
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=
SMILE_ID_WEBHOOK_SECRET=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_PRIVACY_POLICY_URL=http://localhost:3000/privacy
