# Postgres (required for auth + app data)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Smile Identity KYC (optional — verification uses manual admin review by default)
# Leave blank; artisans submit Ghana Card + face check, admins approve at /admin/verifications
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=
SMILE_ID_WEBHOOK_SECRET=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_PRIVACY_POLICY_URL=http://localhost:3000/privacy
