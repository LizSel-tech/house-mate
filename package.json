{
  "name": "house-mate",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:log": "mkdir -p logs && next dev 2>&1 | tee -a logs/server.log",
    "build": "next build",
    "start": "next start",
    "start:log": "mkdir -p logs && next start 2>&1 | tee -a logs/server.log",
    "logs": "mkdir -p logs && touch logs/app.log && tail -n 50 -f logs/app.log",
    "lint": "next lint",
    "db:migrate": "tsx db/migrate.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@paystack/inline-js": "^2.22.2",
    "next": "^16.2.10",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
